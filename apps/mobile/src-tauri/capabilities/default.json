{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main mobile window with app settings and encrypted token storage.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "stronghold:default",
    "stronghold:allow-remove-store-record",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
