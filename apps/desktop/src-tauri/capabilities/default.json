{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main-window access to runtime-selected Loom servers, non-sensitive settings, and OS-backed credential storage. See ADR 0010.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "keyring-store:default",
    "websocket:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
