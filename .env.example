# Example environment for Loom. Copy to `.env` and edit locally.
#
# Real secrets NEVER get committed. `.env` is gitignored; this file is a
# template and must only ever contain obviously-fake placeholder values.

# Log filter for tracing-subscriber (error | warn | info | debug | trace,
# or a full EnvFilter directive such as `info,loom_web_backend=debug`).
LOOM_LOG_LEVEL=info

# Address the web-backend binds to.
LOOM_BIND_ADDR=127.0.0.1:8080
