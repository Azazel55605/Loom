# Example environment for Loom. Copy to `.env` and edit locally.
#
# Real secrets NEVER get committed. `.env` is gitignored; this file is a
# template and must only ever contain obviously-fake placeholder values.

# Log filter for tracing-subscriber (error | warn | info | debug | trace,
# or a full EnvFilter directive such as `info,loom_web_backend=debug`).
LOOM_LOG_LEVEL=info

# Address the web-backend binds to.
LOOM_BIND_ADDR=127.0.0.1:8080

# --- Published image selection (docker-compose.yml only) ---------------------
# These pick WHICH published image and tag `docker compose up` runs. They have
# no effect on docker-compose.local.yml, which always builds from local source.

# GitHub owner (user or org) whose GHCR packages to pull, e.g. `your-github-name`.
# Required — docker-compose.yml fails fast if it is unset.
LOOM_IMAGE_OWNER=your-github-username

# Image tags to run. Defaults to `latest` if unset. Pin these to a released
# version (e.g. 0.1.0) for a reproducible deployment; each product is tagged
# independently, matching its entry in versions.json.
LOOM_WEB_BACKEND_TAG=latest
LOOM_WEB_FRONTEND_TAG=latest

# --- Frontend build-time configuration ---------------------------------------
# Baked into the SPA bundle at build time (docker-compose.local.yml). The
# browser resolves this, so it must be reachable from the user's machine —
# not a compose service name like `http://web-backend:8080`.
VITE_API_URL=http://localhost:8080
