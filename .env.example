# Loom does not require a .env file to run — every variable here is an optional
# override with a working default. This file exists for users who want to
# customize image source/tags or advanced settings, not as a prerequisite for
# basic operation.
#
# `docker compose up` works with no .env at all. See
# docs/adr/0004-zero-config-startup.md.
#
# To use it anyway: copy to `.env` and uncomment what you want to change. Real
# secrets NEVER get committed — `.env` is gitignored, and this file must only
# ever contain obviously-fake placeholder values.
#
# Every line below is commented out on purpose: the value shown is the default
# you would be overriding.

# --- web-backend runtime -----------------------------------------------------

# Log filter for tracing-subscriber (error | warn | info | debug | trace, or a
# full EnvFilter directive such as `info,loom_web_backend=debug`).
#LOOM_LOG_LEVEL=info

# Address the web-backend binds to. The Compose files set 0.0.0.0:8080 so the
# port is reachable from outside the container.
#LOOM_BIND_ADDR=127.0.0.1:8080

# Directory holding the SQLite database (`loom.db`), which stores users, groups,
# permission grants, sessions, and the generated JWT signing secret. Backed by
# the `loom-data` volume in both Compose files. Created if missing; defaults to
# ./data outside a container. Secrets are generated on first boot, never
# supplied here.
#LOOM_DATA_DIR=/data

# Comma-separated browser origins appended to the built-in localhost and Tauri
# origins. Optional: the normal web deployment proxies /api same-origin and
# needs no CORS entry. See docs/adr/0010-desktop-secure-storage-and-network-config.md.
#LOOM_CORS_ALLOWED_ORIGINS=https://loom.example.com,https://loom.example.org

# --- Published image selection (docker-compose.yml only) ---------------------
# These pick WHICH published image and tag `docker compose up` runs. They have
# no effect on docker-compose.local.yml, which always builds from local source.

# GHCR namespace to pull from. Optional — defaults to `loom-project`.
#LOOM_IMAGE_OWNER=loom-project

# Image tags to run. Default to `latest`. Pin these to a released version
# (e.g. 0.1.0) for a reproducible deployment; each product is tagged
# independently, matching its entry in versions.json.
#LOOM_WEB_BACKEND_TAG=latest
#LOOM_WEB_FRONTEND_TAG=latest

# --- Frontend -> backend routing ---------------------------------------------
# Where the frontend's nginx forwards /api. The browser only ever talks to the
# frontend's own origin, so this is resolved INSIDE the container network and
# may be a compose service name. Defaults to http://web-backend:8080; set it
# only if the backend runs somewhere else.
# See docs/adr/0006-frontend-api-same-origin.md.
#LOOM_BACKEND_ORIGIN=http://web-backend:8080

# Escape hatch: bake an absolute API URL into the bundle at build time instead
# of using the /api proxy. Normally leave this unset — a baked URL is resolved
# by the browser, so it only works for whoever built the image, and it makes
# requests cross-origin (see docs/adr/0005-cors-policy.md).
#VITE_API_URL=https://loom.example.com:8080
