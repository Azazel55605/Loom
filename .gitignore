# Rust build output
/target
**/*.rs.bk

# Cargo.lock is intentionally NOT ignored: this workspace produces a binary,
# so the lockfile is committed for reproducible builds.

# Local environment — real secrets never get committed. Copy .env.example.
.env
.env.local
.env.*.local

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
# KDE folder view settings — contains absolute local paths.
.directory

# Editors
.idea/
*.swp
*.swo
*~
# .vscode/ is intentionally kept — shared editor config may be committed.

# Node
node_modules/

# User content
AGENTS.md
CLAUDE.md
docs/AGENT_INSTRUCTIONS.md

# Frontend build output
apps/*/dist/

# Tauri build output
apps/*/src-tauri/target/
apps/*/src-tauri/gen/

# Local development data directory: the SQLite database with user accounts,
# argon2 password hashes, live sessions, and the generated JWT signing secret.
# Created automatically by `cargo run --package loom-web-backend` when
# LOOM_DATA_DIR is unset. Never commit it — this repository is public, and the
# real deployment keeps this on a Docker volume, not in the tree.
/data/
*.db
*.db-wal
*.db-shm
